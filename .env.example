# Template — salin ke `.env` lalu isi nilainya.
#
#   cp .env.example .env
#
# Nilai asli tidak boleh masuk ke file ini.

# Cloudflare API Token (untuk tunnel / DNS)
CLOUDFLARE_API_TOKEN=

# SMTP relay (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pavernor <alvin@pavernor.tech>"

# Opsional. Kalau diisi, dipakai sebagai Reply-To default.
SMTP_REPLY_TO=
